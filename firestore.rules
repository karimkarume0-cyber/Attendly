rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /sessions/{sessionId} {
      // Only the signed-in device that creates a session can read/update it later.
      allow create: if request.auth != null
                    && request.resource.data.adminUid == request.auth.uid;
      allow read, update: if request.auth != null
                    && resource.data.adminUid == request.auth.uid;
      allow delete: if false;

      match /submissions/{submissionId} {
        // Any signed-in participant can add (or retry-resubmit) their own
        // attendance record — retries reuse the same submission ID.
        allow create, update: if request.auth != null
                      && request.resource.data.sessionId == sessionId;
        // Only the session's admin device can read the list or delete an entry.
        allow read, delete: if request.auth != null
                      && get(/databases/$(database)/documents/sessions/$(sessionId)).data.adminUid == request.auth.uid;
      }
    }
  }
}
